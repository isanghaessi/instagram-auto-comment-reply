# Node server port
PORT=3000

# SQLite file DB path. It is created automatically on server start.
DATABASE_PATH=./data/app.db

# Public origin for the admin server. Use HTTPS in production.
PUBLIC_BASE_URL=https://your-domain.example.com

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Use at least 16 random characters in production.
ADMIN_PASSWORD=replace-with-strong-password

# Instagram comment polling interval. Recommended MVP value: 60.
POLLING_INTERVAL_SECONDS=60
