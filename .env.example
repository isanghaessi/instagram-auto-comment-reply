# Node server port
PORT=3000

# SQLite file DB path. It is created automatically on server start.
DATABASE_PATH=./data/app.db

# Public HTTPS origin for the admin server.
PUBLIC_BASE_URL=https://your-domain.example.com

# Meta Developer App credentials.
META_APP_ID=1234567890
META_APP_SECRET=replace-with-meta-app-secret

# Must exactly match the redirect URI registered in Meta App Dashboard.
META_REDIRECT_URI=https://your-domain.example.com/auth/instagram/callback

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Use at least 16 random characters in production.
ADMIN_PASSWORD=replace-with-strong-password

# Instagram comment polling interval. Recommended MVP value: 60.
POLLING_INTERVAL_SECONDS=60
